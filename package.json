{
  "name": "uncat",
  "version": "0.1.0",
  "description": "CLI and library for contextual text expansion for AI agents",
  "keywords": [
    "agents",
    "ai",
    "cli",
    "context",
    "effect",
    "expansion",
    "prompt"
  ],
  "license": "MIT",
  "bin": {
    "uncat": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.mjs"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "node --import ./build/register.ts src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --type-check --deny-warnings",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "demo": "node --import ./build/register.ts scripts/demo.ts",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@effect/vitest": "^4.1.4",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@types/node": "^26.6.6",
    "cleye": "^2.7.0",
    "effect": "^4.1.4",
    "hookable": "^6.1.2",
    "ignore": "^7.0.14",
    "linkify-it": "^6.1.0",
    "magic-string": "^1.4.5",
    "md4x": "^0.0.30",
    "multi-integer-range": "^6.1.0",
    "nano-spawn": "^2.1.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "std-env": "^4.3.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
